# --- Primary: OpenRouter Decisions API (alpha) ---
# Get a key at https://openrouter.ai/keys — pay-as-you-go, no TypeSafe account needed.
OPENROUTER_API_KEY=

# --- Optional: TypeSafe direct (early access, waitlisted) ---
TYPESAFE_API_KEY=

# --- Optional overrides ---
# JEV_PROVIDER=openrouter|typesafe|mock   (default: auto — first provider with a key, else mock)
# JEV_MODEL=typesafe/jev-1.13             (OpenRouter id; "jev-latest" for TypeSafe direct)
# JEV_PROXY_PORT=8787
